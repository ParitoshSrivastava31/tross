# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# LinkedIn Session Credentials (Optional backend defaults)
# Obtain from browser cookies when signed into LinkedIn
# LI_AT_COOKIE=AQEDAT...
# JSESSIONID=ajax:1234567890123456789

# Demo & Fallback Configuration
ENABLE_SANDBOX_FALLBACK=true

# Security & Traffic Controls
RATE_LIMIT_MAX=100
CORS_ORIGIN=*

# Optional HTTP/HTTPS Rotating Proxy for high-volume enterprise scraping
# PROXY_URL=http://user:pass@proxy-server:8080
